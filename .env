# Get this from @BotFather on Telegram
BOT_TOKEN=

# Port for the server that hosts the Mini App + manifest.json
PORT=3000

# The PUBLIC https URL where manifest.json will be reachable once deployed.
# e.g. https://your-app.onrender.com/manifest.json
# TON wallets fetch this URL to display your app's name/icon during connection.
TONCONNECT_MANIFEST_URL=

# The PUBLIC https URL of the Mini App itself (same domain, no trailing path needed
# beyond what you deploy). e.g. https://your-app.onrender.com/
# This is what /connect opens as a Telegram web_app button.
WEBAPP_URL=

# --- Contract-signing payment flow ---

# The TON wallet address that receives signing-fee payments.
RECEIVER_ADDRESS=

# Comma-separated Telegram user IDs allowed to run /invoice, e.g. 123456,789012
ADMIN_TELEGRAM_IDS=

# Free API key from https://tonconsole.com — used to verify payments actually
# landed on-chain before marking an order confirmed. Without this, payments
# stay at 'submitted' and are never auto-confirmed (fails safe, not silently).
TONAPI_KEY=
