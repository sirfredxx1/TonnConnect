# Get this from @BotFather on Telegram
BOT_TOKEN=

# Port for the server that hosts the Mini App + manifest.json
PORT=3000

# The PUBLIC https URL where manifest.json will be reachable once deployed.
# e.g. https://your-app.onrender.com/manifest.json
# TON wallets fetch this URL to display your app's name/icon during connection.
TONCONNECT_MANIFEST_URL=

# The PUBLIC https URL of the Mini App itself (same domain, no trailing path needed
# beyond what you deploy). e.g. https://your-app.onrender.com/
# This is what /connect opens as a Telegram web_app button.
WEBAPP_URL=
